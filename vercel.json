{
  "rewrites": [
    {
      "source": "/api/stock/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/news/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/analyze",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
